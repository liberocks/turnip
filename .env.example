# Local demonstration values only. Generate a different 32+ byte secret for any
# shared or internet-accessible deployment.
TURNIP_JWT_SECRET=turnip-local-demo-secret-change-me-now
TURNIP_JWT_ISSUER=turnip-demo
TURNIP_JWT_AUDIENCE=turnip

# Used when running the binary directly. Compose overrides addresses as needed.
TURNIP_HTTP_ADDR=:5004
TURNIP_REDIS_URL=redis://localhost:6379/0
TURNIP_INSTANCE_ID=turnip-local
TURNIP_ALLOWED_ORIGINS=http://localhost:8080
TURNIP_METRICS_ADDR=127.0.0.1:9090
TURNIP_LOG_LEVEL=info
TURNIP_LOG_FORMAT=console
TURNIP_VERSION=dev

# Set both or neither.
# TURNIP_METRICS_USERNAME=prometheus
# TURNIP_METRICS_PASSWORD=replace-me
